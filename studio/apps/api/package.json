{
  "name": "@makucho/studio-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "rimraf dist tsconfig.tsbuildinfo && tsc -p tsconfig.json && node scripts/copiar-prompts.mjs",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit --tsBuildInfoFile .tsbuildinfo-typecheck",
    "test": "tsx test/tenant-isolation.test.ts && tsx test/ai-adapter.test.ts && tsx test/roteiro-ia.test.ts && tsx test/assets.test.ts && tsx test/pexels.test.ts && tsx test/fontes-de-midia.test.ts"
  },
  "dependencies": {
    "@makucho/studio-contracts": "workspace:*",
    "@makucho/studio-database": "workspace:*",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.2.1",
    "argon2": "^0.41.1",
    "bullmq": "^5.28.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "onnxruntime-web": "1.30.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@makucho/eslint-config": "workspace:*",
    "@makucho/typescript-config": "workspace:*",
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.5",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^10.10.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3"
  }
}
