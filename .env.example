# ==========================================
# MAKUCHO - Variaveis de ambiente
# Copie para .env e ajuste os valores
# ==========================================

NODE_ENV=development

# ---------- Banco de dados (PostgreSQL) ----------
POSTGRES_USER=makucho
POSTGRES_PASSWORD=makucho_dev_password_change_me
POSTGRES_DB=makucho
# ATENCAO: 5432 e 5433 costumam estar ocupadas por um PostgreSQL instalado
# no Windows. Esta porta e so o acesso do host ao container; dentro da rede
# Docker o Postgres continua em 5432.
POSTGRES_PORT=5434
# Host "postgres" = nome do servico no docker-compose.
# Rodando fora do Docker, troque para localhost.
DATABASE_URL=postgresql://makucho:makucho_dev_password_change_me@postgres:5432/makucho?schema=public

# ---------- API (NestJS) ----------
API_PORT=3001
API_PREFIX=api
# Origens permitidas para CORS, separadas por virgula
CORS_ORIGINS=http://localhost:3000,http://localhost

# ---------- Autenticacao ----------
# TROQUE em producao. Gere com: openssl rand -base64 48
JWT_ACCESS_SECRET=dev_access_secret_change_me_in_production_please
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_in_production_please
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
# Bloqueio por tentativas de login
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# ---------- Usuario administrador inicial (seed) ----------
SEED_ADMIN_EMAIL=admin@makucho.com.br
SEED_ADMIN_PASSWORD=Makucho@2026
SEED_ADMIN_NAME=Administrador MAKUCHO

# ---------- Storage de imagens ----------
# "disk" guarda no proprio volume e deixa o nginx servir: e o padrao,
# porque um portal editorial nao move volume que justifique manter um
# servidor de objetos consumindo memoria.
# Valores possiveis: disk | minio | s3 | r2 | b2
STORAGE_PROVIDER=disk
STORAGE_DISK_PATH=./storage/media
# Onde as imagens ficam publicas. Em producao, ${PUBLIC_APP_URL}/files.
STORAGE_PUBLIC_URL=http://localhost:3001/files

# Abaixo, so para os provedores S3-compativeis:
# STORAGE_BUCKET=makucho-media
# STORAGE_REGION=us-east-1
# STORAGE_ENDPOINT=https://...
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_FORCE_PATH_STYLE=true

# ---------- Upload / processamento de imagens ----------
UPLOAD_MAX_FILE_SIZE_MB=15
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp,image/avif,image/gif
IMAGE_KEEP_ORIGINAL=true
IMAGE_JPEG_QUALITY=82
IMAGE_WEBP_QUALITY=80
IMAGE_AVIF_QUALITY=55
IMAGE_GENERATE_AVIF=true

# ---------- Frontend (Next.js) ----------
WEB_PORT=3000
# URL da API vista pelo navegador (passa pelo Nginx)
NEXT_PUBLIC_API_URL=http://localhost/api
# URL da API vista pelo servidor Next dentro do Docker
INTERNAL_API_URL=http://api:3001/api
NEXT_PUBLIC_SITE_URL=http://localhost
NEXT_PUBLIC_SITE_NAME=MAKUCHO

# ---------- Nginx ----------
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_MAX_BODY_SIZE=20m

# ---------- Rate limiting ----------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_MAX=10

# ---------- Dados de mercado (ticker) ----------
# auto (padrão): cotações de fontes públicas a cada 10 min · off: só o painel
MARKET_DATA_PROVIDER=auto
# Token gratuito da brapi.dev para o Ibovespa (opcional; sem ele usa o Yahoo Finance)
MARKET_DATA_API_KEY=
MARKET_DATA_REFRESH_MINUTES=15

# ---------- Newsletter (provider desacoplado) ----------
# none | resend | mailchimp | brevo
NEWSLETTER_PROVIDER=none
NEWSLETTER_API_KEY=
NEWSLETTER_FROM_EMAIL=contato@makucho.com.br
NEWSLETTER_LIST_ID=

# ---------- Analytics interno ----------
ANALYTICS_ENABLED=true
# Salt para gerar hash anonimo de sessao (nao guardamos IP puro)
ANALYTICS_SESSION_SALT=dev_analytics_salt_change_me
ANALYTICS_VIEW_DEDUPE_MINUTES=30
