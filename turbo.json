{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  // Variaveis que invalidam o cache quando mudam. Uma variavel ausente
  // daqui faz o turbo reaproveitar um build feito com outro valor — no
  // Next isso e grave, porque NEXT_PUBLIC_* fica embutida no bundle.
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_SITE_URL",
    "STUDIO_DATABASE_URL",
    "NEXT_PUBLIC_STUDIO_API_URL",
    "NEXT_PUBLIC_STUDIO_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // src/generated: o client Prisma do studio sai ali, e nao em
      // dist/. Sem declarar, o turbo avisa que a tarefa nao produziu
      // saida e refaz o generate a cada execucao.
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "src/generated/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "db:generate": {
      "cache": false
    }
  }
}
