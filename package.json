{
  "name": "makucho",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "db:generate": "pnpm --filter @makucho/database db:generate",
    "db:migrate": "pnpm --filter @makucho/database db:migrate",
    "db:deploy": "pnpm --filter @makucho/database db:deploy",
    "db:seed": "pnpm --filter @makucho/api seed",
    "db:studio": "pnpm --filter @makucho/database db:studio",
    "db:reset": "pnpm --filter @makucho/database db:reset",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:rebuild": "docker compose up -d --build"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "tsx": "^4.23.13",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "argon2",
      "sharp",
      "@prisma/client",
      "prisma",
      "next"
    ]
  }
}
