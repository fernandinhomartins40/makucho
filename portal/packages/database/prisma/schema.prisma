// ============================================================
// MAKUCHO - Schema do banco de dados
// Portal editorial de economia + CMS
// ============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  AUTHOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
}

enum PostStatus {
  DRAFT
  REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum VideoPlatform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  OTHER
}

enum AdStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
}

enum AdPlacement {
  HOME_TOP
  HOME_AFTER_HERO
  HOME_MIDDLE
  SIDEBAR_TOP
  SIDEBAR_MIDDLE
  ARTICLE_TOP
  ARTICLE_MIDDLE
  ARTICLE_BOTTOM
  FOOTER
}

enum AdDeviceTarget {
  ALL
  DESKTOP
  MOBILE
}

/// Formatos padrão IAB (ver AD_FORMAT_DEFINITIONS em @makucho/types)
enum AdFormat {
  LEADERBOARD
  BILLBOARD
  RECTANGLE
  HALF_PAGE
}

/// FIXED = valor do período; CPM = por mil impressões; CPC = por clique
enum AdPricingModel {
  FIXED
  CPM
  CPC
}

/// Cobrança controlada pela redação (sem gateway de pagamento)
enum AdBillingStatus {
  PENDING
  INVOICED
  PAID
  OVERDUE
  COURTESY
}

enum NewsletterStatus {
  ACTIVE
  UNSUBSCRIBED
  PENDING
}

enum HomepageSectionType {
  HERO
  LATEST_POSTS
  TRENDING
  VIDEOS
  CATEGORIES
  MOST_READ
  NEWSLETTER
  AD_SLOT
  CUSTOM_POSTS
}

enum DeviceType {
  DESKTOP
  MOBILE
  TABLET
  UNKNOWN
}

enum MediaVariantType {
  ORIGINAL
  LARGE
  MEDIUM
  SMALL
  THUMBNAIL
}

enum ImagePreset {
  HERO
  POST_CARD
  VIDEO_THUMBNAIL
  SQUARE
  SOCIAL
  SIDEBAR
  AVATAR
  CATEGORY
  FREEFORM
  AD_LEADERBOARD
  AD_BILLBOARD
  AD_RECTANGLE
  AD_HALF_PAGE
}

// ============================================================
// USUARIOS, PERMISSOES E SESSOES
// ============================================================

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  name         String     @db.VarChar(160)
  role         UserRole   @default(AUTHOR)
  status       UserStatus @default(ACTIVE)

  avatarMediaId String? @map("avatar_media_id") @db.Uuid
  avatarMedia   Media?  @relation("UserAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)

  // Controle de tentativas de login (secao 30)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  lastLoginAt         DateTime? @map("last_login_at")

  // Recuperacao de senha
  passwordResetToken     String?   @unique @map("password_reset_token") @db.VarChar(255)
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at")
  mustChangePassword     Boolean   @default(false) @map("must_change_password")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  permissions   UserPermission[]
  refreshTokens RefreshToken[]
  authoredPosts Post[]           @relation("PostCreatedBy")
  postRevisions PostRevision[]
  uploadedMedia Media[]          @relation("MediaUploadedBy")
  auditLogs     AuditLog[]
  authorProfile Author?

  @@index([email])
  @@index([role, status])
  @@index([deletedAt])
  @@map("users")
}

/// Permissoes granulares no formato "recurso:acao" (ex.: "posts:publish").
/// O papel (UserRole) define o padrao; estas linhas concedem ou negam extras.
model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique @db.VarChar(80)
  resource    String  @db.VarChar(40)
  action      String  @db.VarChar(40)
  description String? @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")

  users UserPermission[]

  @@index([resource])
  @@map("permissions")
}

model UserPermission {
  userId       String @map("user_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  /// false = nega explicitamente, sobrepondo o padrao do papel
  granted Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([permissionId])
  @@map("user_permissions")
}

/// Refresh token rotacionavel (secao 30). Guardamos apenas o hash.
model RefreshToken {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash") @db.VarChar(255)
  familyId  String @map("family_id") @db.Uuid

  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  /// Preenchido quando o token e rotacionado, para detectar reuso
  replacedByTokenHash String?   @map("replaced_by_token_hash") @db.VarChar(255)

  ipAddress String? @map("ip_address") @db.VarChar(64)
  userAgent String? @map("user_agent") @db.VarChar(512)

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ============================================================
// MIDIA (secoes 12, 13, 16)
// Binarios NUNCA no banco: guardamos apenas storageKey (S3/MinIO)
// ============================================================

model Media {
  id               String    @id @default(uuid()) @db.Uuid
  type             MediaType @default(IMAGE)
  filename         String    @db.VarChar(255)
  /// Nome original enviado pelo usuario, preservado para exibicao
  originalFilename String    @map("original_filename") @db.VarChar(255)
  mimeType         String    @map("mime_type") @db.VarChar(100)
  size             Int
  width            Int?
  height           Int?
  /// Hash do conteudo, evita subir a mesma imagem duas vezes
  checksum         String?   @db.VarChar(64)

  /// Caminho dentro do bucket. A URL publica e montada pelo StorageProvider.
  storageKey String @unique @map("storage_key") @db.VarChar(512)
  bucket     String @db.VarChar(120)

  alt     String? @db.VarChar(320)
  caption String? @db.VarChar(500)
  credit  String? @db.VarChar(160)
  title   String? @db.VarChar(255)

  preset        ImagePreset @default(FREEFORM)
  /// Cor media da imagem, usada como placeholder enquanto carrega (LQIP)
  dominantColor String?     @map("dominant_color") @db.VarChar(9)
  blurDataUrl   String?     @map("blur_data_url") @db.Text

  uploadedById String? @map("uploaded_by_id") @db.Uuid
  uploadedBy   User?   @relation("MediaUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  variants MediaVariant[]

  // Relacoes reversas
  postsAsCover      Post[]          @relation("PostCoverImage")
  postsAsThumbnail  Post[]          @relation("PostThumbnail")
  postsAsOgImage    Post[]          @relation("PostOgImage")
  categoriesAsCover Category[]      @relation("CategoryCover")
  videosAsThumbnail Video[]         @relation("VideoThumbnail")
  ads               Advertisement[]
  authorsAsAvatar   Author[]        @relation("AuthorAvatar")
  usersAsAvatar     User[]          @relation("UserAvatar")

  @@index([type, deletedAt])
  @@index([createdAt])
  @@index([checksum])
  @@index([uploadedById])
  @@map("media")
}

/// Cada variante gerada pelo Sharp (tamanho x formato).
model MediaVariant {
  id      String           @id @default(uuid()) @db.Uuid
  mediaId String           @map("media_id") @db.Uuid
  type    MediaVariantType
  /// jpeg | webp | avif | png
  format  String           @db.VarChar(10)

  width  Int
  height Int
  size   Int

  storageKey String @unique @map("storage_key") @db.VarChar(512)

  createdAt DateTime @default(now()) @map("created_at")

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, type, format])
  @@index([mediaId])
  @@map("media_variants")
}

// ============================================================
// TAXONOMIA: CATEGORIAS E TAGS (secao 25)
// Categorias sao gerenciadas pelo CMS, nunca hardcoded no front
// ============================================================

model Category {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(120)
  slug        String  @unique @db.VarChar(140)
  description String? @db.VarChar(500)
  /// Cor de destaque da categoria (hex), usada nas tarjas dos cards
  color       String? @db.VarChar(9)
  icon        String? @db.VarChar(60)

  coverMediaId String? @map("cover_media_id") @db.Uuid
  coverMedia   Media?  @relation("CategoryCover", fields: [coverMediaId], references: [id], onDelete: SetNull)

  /// Subcategorias
  parentId String?    @map("parent_id") @db.Uuid
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  position       Int     @default(0)
  showInMenu     Boolean @default(true) @map("show_in_menu")
  showInHomepage Boolean @default(true) @map("show_in_homepage")
  isActive       Boolean @default(true) @map("is_active")

  seoTitle       String? @map("seo_title") @db.VarChar(200)
  seoDescription String? @map("seo_description") @db.VarChar(320)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  posts  Post[]
  videos Video[]

  @@index([slug])
  @@index([parentId])
  @@index([isActive, position])
  @@map("categories")
}

model Tag {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(80)
  slug        String  @unique @db.VarChar(100)
  description String? @db.VarChar(320)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  posts PostTag[]

  @@index([slug])
  @@map("tags")
}

model PostTag {
  postId String @map("post_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tags")
}

// ============================================================
// AUTOR (perfil editorial publico)
// ============================================================

model Author {
  id   String  @id @default(uuid()) @db.Uuid
  name String  @db.VarChar(160)
  slug String  @unique @db.VarChar(180)
  bio  String? @db.Text
  role String? @db.VarChar(120)

  avatarMediaId String? @map("avatar_media_id") @db.Uuid
  avatarMedia   Media?  @relation("AuthorAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)

  email     String? @db.VarChar(255)
  instagram String? @db.VarChar(255)
  tiktok    String? @db.VarChar(255)
  youtube   String? @db.VarChar(255)
  twitter   String? @db.VarChar(255)
  linkedin  String? @db.VarChar(255)
  website   String? @db.VarChar(255)

  /// Vinculo opcional com uma conta do CMS
  userId String? @unique @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  posts  Post[]
  videos Video[]

  @@index([slug])
  @@map("authors")
}

// ============================================================
// POSTS (secoes 10, 11, 27, 34)
// ============================================================

model Post {
  id       String     @id @default(uuid()) @db.Uuid
  title    String     @db.VarChar(255)
  slug     String     @unique @db.VarChar(280)
  subtitle String?    @db.VarChar(320)
  excerpt  String?    @db.VarChar(600)
  status   PostStatus @default(DRAFT)

  /// Conteudo do TipTap em JSON (fonte da verdade)
  content     Json?
  /// HTML renderizado e sanitizado no servidor, para leitura rapida
  contentHtml Json?   @map("content_html")
  /// Texto puro, alimenta a busca full text e o calculo de leitura
  contentText String? @map("content_text") @db.Text

  readingTimeMinutes Int @default(1) @map("reading_time_minutes")
  wordCount          Int @default(0) @map("word_count")

  // ---- Imagens ----
  coverImageId String? @map("cover_image_id") @db.Uuid
  coverImage   Media?  @relation("PostCoverImage", fields: [coverImageId], references: [id], onDelete: SetNull)

  thumbnailId String? @map("thumbnail_id") @db.Uuid
  thumbnail   Media?  @relation("PostThumbnail", fields: [thumbnailId], references: [id], onDelete: SetNull)

  // ---- Taxonomia e autoria ----
  categoryId String   @map("category_id") @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  authorId String? @map("author_id") @db.Uuid
  author   Author? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  /// Conta do CMS que criou o registro (para RBAC de AUTHOR)
  createdById String? @map("created_by_id") @db.Uuid
  createdBy   User?   @relation("PostCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // ---- Video relacionado (secao 2) ----
  videoPlatform VideoPlatform? @map("video_platform")
  videoUrl      String?        @map("video_url") @db.VarChar(600)
  videoEmbedId  String?        @map("video_embed_id") @db.VarChar(160)

  // ---- Flags editoriais (secoes 10, 23, 33) ----
  isFeatured    Boolean @default(false) @map("is_featured")
  isHomepageTop Boolean @default(false) @map("is_homepage_top")
  isTrending    Boolean @default(false) @map("is_trending")
  isPinned      Boolean @default(false) @map("is_pinned")
  allowComments Boolean @default(false) @map("allow_comments")

  // ---- SEO (secao 34) ----
  seoTitle       String? @map("seo_title") @db.VarChar(200)
  seoDescription String? @map("seo_description") @db.VarChar(320)
  canonicalUrl   String? @map("canonical_url") @db.VarChar(600)
  /// index,follow | noindex,nofollow ...
  robots         String  @default("index,follow") @db.VarChar(80)

  ogImageId String? @map("og_image_id") @db.Uuid
  ogImage   Media?  @relation("PostOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)

  // ---- Datas ----
  publishedAt  DateTime? @map("published_at")
  scheduledFor DateTime? @map("scheduled_for")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  /// Contador desnormalizado, mantido em sincronia com PostView.
  /// Evita COUNT() caro nas listagens de "mais lidas".
  viewCount Int @default(0) @map("view_count")

  tags      PostTag[]
  revisions PostRevision[]
  views     PostView[]
  videos    Video[]

  relatedTo   PostRelation[] @relation("RelationSource")
  relatedFrom PostRelation[] @relation("RelationTarget")

  homepageItems HomepageSectionItem[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([categoryId, status, publishedAt(sort: Desc)])
  @@index([authorId])
  @@index([slug])
  @@index([isFeatured, status])
  @@index([isTrending, status])
  @@index([scheduledFor])
  @@index([viewCount(sort: Desc)])
  @@index([deletedAt])
  @@map("posts")
}

/// Artigos relacionados escolhidos manualmente (secao 10)
model PostRelation {
  postId        String @map("post_id") @db.Uuid
  relatedPostId String @map("related_post_id") @db.Uuid
  position      Int    @default(0)

  post        Post @relation("RelationSource", fields: [postId], references: [id], onDelete: Cascade)
  relatedPost Post @relation("RelationTarget", fields: [relatedPostId], references: [id], onDelete: Cascade)

  @@id([postId, relatedPostId])
  @@index([relatedPostId])
  @@map("post_relations")
}

/// Historico de versoes do artigo (secao 11)
model PostRevision {
  id     String @id @default(uuid()) @db.Uuid
  postId String @map("post_id") @db.Uuid

  title    String  @db.VarChar(255)
  subtitle String? @db.VarChar(320)
  excerpt  String? @db.VarChar(600)
  content  Json?

  /// Numero sequencial da revisao dentro do post
  revisionNumber Int     @map("revision_number")
  /// autosave | manual | publish
  changeType     String  @default("manual") @map("change_type") @db.VarChar(20)
  changeSummary  String? @map("change_summary") @db.VarChar(320)

  createdById String? @map("created_by_id") @db.Uuid
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, revisionNumber])
  @@index([postId, createdAt(sort: Desc)])
  @@map("post_revisions")
}

// ============================================================
// VIDEOS (secao 24)
// ============================================================

model Video {
  id          String        @id @default(uuid()) @db.Uuid
  title       String        @db.VarChar(255)
  slug        String        @unique @db.VarChar(280)
  description String?       @db.Text
  platform    VideoPlatform
  url         String        @db.VarChar(600)
  /// ID extraido da URL, usado para montar o embed
  embedId     String?       @map("embed_id") @db.VarChar(160)

  /// Duracao em segundos; exibida como 8:24 nos cards
  durationSeconds Int? @map("duration_seconds")

  thumbnailId String? @map("thumbnail_id") @db.Uuid
  thumbnail   Media?  @relation("VideoThumbnail", fields: [thumbnailId], references: [id], onDelete: SetNull)

  categoryId String?   @map("category_id") @db.Uuid
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  authorId String? @map("author_id") @db.Uuid
  author   Author? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  /// Artigo complementar ao video (secao 2)
  postId String? @map("post_id") @db.Uuid
  post   Post?   @relation(fields: [postId], references: [id], onDelete: SetNull)

  isPublished Boolean @default(true) @map("is_published")
  isFeatured  Boolean @default(false) @map("is_featured")
  position    Int     @default(0)
  viewCount   Int     @default(0) @map("view_count")

  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  homepageItems HomepageSectionItem[]

  @@index([isPublished, publishedAt(sort: Desc)])
  @@index([platform])
  @@index([slug])
  @@index([postId])
  @@map("videos")
}

// ============================================================
// PUBLICIDADE (secao 26)
// ============================================================

model Advertisement {
  id         String  @id @default(uuid()) @db.Uuid
  name       String  @db.VarChar(160)
  /// Anunciante / cliente
  advertiser String? @db.VarChar(160)

  mediaId String? @map("media_id") @db.Uuid
  media   Media?  @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  /// Criativo alternativo para telas pequenas
  mobileMediaId String? @map("mobile_media_id") @db.Uuid

  targetUrl    String  @map("target_url") @db.VarChar(800)
  alt          String  @db.VarChar(320)
  /// Abrir em nova aba
  openInNewTab Boolean @default(true) @map("open_in_new_tab")
  /// rel do link: sponsored/nofollow por padrao, exigido por SEO
  linkRel      String  @default("sponsored noopener noreferrer") @map("link_rel") @db.VarChar(120)

  status   AdStatus       @default(DRAFT)
  device   AdDeviceTarget @default(ALL)
  /// Prioridade maior aparece primeiro quando ha varios no mesmo slot
  priority Int            @default(0)

  widthPx  Int? @map("width_px")
  heightPx Int? @map("height_px")

  startsAt DateTime? @map("starts_at")
  endsAt   DateTime? @map("ends_at")

  impressions Int @default(0)
  clicks      Int @default(0)

  // ---- Comercial ----
  format          AdFormat?
  /// Patrocínio da posição: com um exclusivo ativo, só exclusivos aparecem nela
  isExclusive     Boolean         @default(false) @map("is_exclusive")
  pricingModel    AdPricingModel  @default(FIXED) @map("pricing_model")
  /// R$: total do período (FIXED), por mil impressões (CPM) ou por clique (CPC)
  price           Decimal?        @db.Decimal(12, 2)
  /// CPM: ao atingir a meta, o anúncio deixa de ser exibido
  impressionGoal  Int?            @map("impression_goal")
  billingStatus   AdBillingStatus @default(PENDING) @map("billing_status")
  billingDueDate  DateTime?       @map("billing_due_date")
  paidAt          DateTime?       @map("paid_at")
  contactName     String?         @map("contact_name") @db.VarChar(160)
  contactEmail    String?         @map("contact_email") @db.VarChar(255)
  contactPhone    String?         @map("contact_phone") @db.VarChar(40)
  billingNotes    String?         @map("billing_notes") @db.VarChar(2000)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  placements AdPlacementAssignment[]
  events     AdEvent[]

  @@index([status, startsAt, endsAt])
  @@index([priority(sort: Desc)])
  @@index([billingStatus, billingDueDate])
  @@map("advertisements")
}

/// Um anuncio pode ocupar varias posicoes do site
model AdPlacementAssignment {
  id        String      @id @default(uuid()) @db.Uuid
  adId      String      @map("ad_id") @db.Uuid
  placement AdPlacement
  position  Int         @default(0)

  ad Advertisement @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@unique([adId, placement])
  @@index([placement])
  @@map("ad_placement_assignments")
}

/// Registro bruto de impressoes e cliques (secao 26)
model AdEvent {
  id   String @id @default(uuid()) @db.Uuid
  adId String @map("ad_id") @db.Uuid
  /// impression | click
  type String @db.VarChar(12)

  placement   AdPlacement?
  sessionHash String?      @map("session_hash") @db.VarChar(64)
  device      DeviceType   @default(UNKNOWN)
  referrer    String?      @db.VarChar(600)

  createdAt DateTime @default(now()) @map("created_at")

  ad Advertisement @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([adId, type, createdAt])
  @@index([createdAt])
  @@map("ad_events")
}

// ============================================================
// NEWSLETTER (secao 29)
// ============================================================

model NewsletterSubscriber {
  id     String           @id @default(uuid()) @db.Uuid
  email  String           @unique @db.VarChar(255)
  name   String?          @db.VarChar(160)
  status NewsletterStatus @default(ACTIVE)

  /// De onde veio a inscricao: homepage | article | footer | popup
  source String? @db.VarChar(60)

  /// Consentimento explicito (LGPD)
  consent       Boolean   @default(false)
  consentAt     DateTime? @map("consent_at")
  /// IP no momento do consentimento, exigido como prova legal
  consentIpHash String?   @map("consent_ip_hash") @db.VarChar(64)

  confirmationToken String?   @unique @map("confirmation_token") @db.VarChar(255)
  confirmedAt       DateTime? @map("confirmed_at")
  unsubscribedAt    DateTime? @map("unsubscribed_at")
  unsubscribeToken  String?   @unique @map("unsubscribe_token") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("newsletter_subscribers")
}

// ============================================================
// CONFIGURACOES DO PORTAL (secao 13 do admin)
// Chave/valor tipado, editavel pelo painel
// ============================================================

model SiteSetting {
  id    String @id @default(uuid()) @db.Uuid
  key   String @unique @db.VarChar(120)
  value Json
  /// string | number | boolean | json | media | color
  type  String @default("string") @db.VarChar(20)
  /// Agrupamento na tela de configuracoes: general | seo | social | ads | newsletter
  group String @default("general") @db.VarChar(40)

  label       String? @db.VarChar(160)
  description String? @db.VarChar(400)
  /// Se true, pode ser lido pelo portal publico sem autenticacao
  isPublic    Boolean @default(true) @map("is_public")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([group])
  @@map("site_settings")
}

/// Redes sociais exibidas no header/footer (secao 18)
model SocialProfile {
  id       String  @id @default(uuid()) @db.Uuid
  platform String  @db.VarChar(40)
  label    String  @db.VarChar(80)
  url      String  @db.VarChar(600)
  handle   String? @db.VarChar(120)
  icon     String? @db.VarChar(60)

  /// Exibido nos cards "120 mil seguidores"
  followerCount Int?    @map("follower_count")
  followerLabel String? @map("follower_label") @db.VarChar(60)

  position      Int     @default(0)
  isActive      Boolean @default(true) @map("is_active")
  showInHeader  Boolean @default(true) @map("show_in_header")
  showInFooter  Boolean @default(true) @map("show_in_footer")
  showInSidebar Boolean @default(true) @map("show_in_sidebar")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([platform])
  @@index([isActive, position])
  @@map("social_profiles")
}

// ============================================================
// HOMEPAGE EDITAVEL (secao 33)
// A home NAO e hardcoded: o admin monta as secoes
// ============================================================

model HomepageSection {
  id       String              @id @default(uuid()) @db.Uuid
  type     HomepageSectionType
  title    String?             @db.VarChar(160)
  subtitle String?             @db.VarChar(320)

  position  Int     @default(0)
  isVisible Boolean @default(true) @map("is_visible")

  /// Ajustes por tipo de secao: limite de itens, layout, slot de anuncio...
  config Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items HomepageSectionItem[]

  @@index([position])
  @@map("homepage_sections")
}

/// Curadoria manual: o admin fixa posts/videos numa secao
model HomepageSectionItem {
  id        String @id @default(uuid()) @db.Uuid
  sectionId String @map("section_id") @db.Uuid
  position  Int    @default(0)

  postId  String? @map("post_id") @db.Uuid
  videoId String? @map("video_id") @db.Uuid

  section HomepageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  post    Post?           @relation(fields: [postId], references: [id], onDelete: Cascade)
  video   Video?          @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([sectionId, position])
  @@index([postId])
  @@index([videoId])
  @@map("homepage_section_items")
}

// ============================================================
// TICKER FINANCEIRO (secao 19)
// Provider abstrato: em modo "manual" o admin edita os valores
// ============================================================

model MarketIndicator {
  id     String  @id @default(uuid()) @db.Uuid
  /// IBOVESPA | USD | EUR | BTC | SELIC
  symbol String  @unique @db.VarChar(40)
  label  String  @db.VarChar(80)
  /// Texto auxiliar exibido no ticker, ex.: "R$" ou "a.a."
  unit   String? @db.VarChar(20)
  icon   String? @db.VarChar(60)

  value          Decimal  @db.Decimal(18, 4)
  changePercent  Decimal? @map("change_percent") @db.Decimal(8, 4)
  changeAbsolute Decimal? @map("change_absolute") @db.Decimal(18, 4)

  /// manual | api
  source String @default("manual") @db.VarChar(20)

  position Int     @default(0)
  isActive Boolean @default(true) @map("is_active")

  lastUpdatedAt DateTime @default(now()) @map("last_updated_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([isActive, position])
  @@map("market_indicators")
}

// ============================================================
// ANALYTICS INTERNO (secao 41)
// Sem dados pessoais: apenas hash anonimo de sessao
// ============================================================

model PostView {
  id     String @id @default(uuid()) @db.Uuid
  postId String @map("post_id") @db.Uuid

  /// Hash irreversivel de (ip + userAgent + salt + dia). Nunca o IP puro.
  sessionHash     String     @map("session_hash") @db.VarChar(64)
  referrer        String?    @db.VarChar(600)
  device          DeviceType @default(UNKNOWN)
  /// Codigo do pais, se disponivel pelo proxy
  country         String?    @db.VarChar(2)
  /// Segundos de permanencia, enviados no unload
  durationSeconds Int?       @map("duration_seconds")

  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([createdAt])
  @@index([sessionHash, postId])
  @@map("post_views")
}

/// Termos buscados, para entender o interesse do publico (secao 28)
model SearchQuery {
  id             String @id @default(uuid()) @db.Uuid
  term           String @db.VarChar(255)
  /// Termo normalizado (minusculo, sem acento) para agrupar
  normalizedTerm String @map("normalized_term") @db.VarChar(255)

  resultCount     Int        @default(0) @map("result_count")
  sessionHash     String?    @map("session_hash") @db.VarChar(64)
  device          DeviceType @default(UNKNOWN)
  /// Slug do post clicado a partir do resultado, se houve clique
  clickedPostSlug String?    @map("clicked_post_slug") @db.VarChar(280)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([normalizedTerm])
  @@index([createdAt])
  @@map("search_queries")
}

// ============================================================
// AUDITORIA (secao 40)
// ============================================================

model AuditLog {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String? @map("user_id") @db.Uuid
  /// Guardado como texto: sobrevive a exclusao do usuario
  userEmail String? @map("user_email") @db.VarChar(255)

  /// login | create | update | delete | publish | permission_change ...
  action     String  @db.VarChar(60)
  /// post | user | media | advertisement | setting ...
  resource   String  @db.VarChar(60)
  resourceId String? @map("resource_id") @db.VarChar(64)
  /// Descricao legivel para a tela de auditoria
  summary    String? @db.VarChar(400)

  /// Hash do IP; nao guardamos o endereco puro
  ipHash    String? @map("ip_hash") @db.VarChar(64)
  userAgent String? @map("user_agent") @db.VarChar(512)

  /// Diferenca antes/depois e contexto adicional
  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([resource, resourceId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}
